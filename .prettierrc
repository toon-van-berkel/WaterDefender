{
  "plugins": [
    "prettier-plugin-blade",
    "prettier-plugin-tailwindcss"
  ],
  "overrides": [
    {
      "files": "*.blade.php",
      "options": {
        "parser": "blade",
        "tabWidth": 4,
        "printWidth": 120,
        "bladeComponentPrefixes": ["x", "livewire", "native"],
        "bladeEchoSpacing": "space",
        "bladeDirectiveArgSpacing": "space"
      }
    }
  ]
}   